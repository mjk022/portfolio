   "source": [
    "#내가 크롤링하고 싶은 구글플레이 스토어 앱 페이지\n",
    "URL = \"내가 크롤링하고 싶은 구글플레이 스토어 앱 페이지""
   ]
  },
  {
   "cell_type": "code",
